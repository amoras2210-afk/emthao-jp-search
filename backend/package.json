{
  "name": "emthaojp-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "install:browsers": "playwright install chromium",
    "test": "npm run test:unit && npm run test:failures && npm run test:integration",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:failures": "node --test \"test/scraper-failures/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "lru-cache": "^11.0.2",
    "p-limit": "^3.1.0",
    "pino": "^9.5.0",
    "playwright": "1.59.1"
  },
  "devDependencies": {
    "pino-pretty": "^11.3.0"
  }
}
